---
import { actions, isInputError } from 'astro:actions';
import Confirm from '../components/Confirm.astro';
import Layout from '../layouts/Layout.astro';
import { cardSummaries, shortDate } from '../lib/cards';
import { formatMoney, today } from '../lib/money';
import { contribution, fairPct } from '../lib/split';

const sb = Astro.locals.supabase;
const me = Astro.locals.userId;
const setResult = Astro.getActionResult(actions.setContribution);
const setError = setResult?.error && (isInputError(setResult.error) ? Object.values(setResult.error.fields).flat()[0] : setResult.error.message);
const paidResult = Astro.getActionResult(actions.createTransfer);
const flash = (setResult && !setResult.error && 'aporte actualizado') ||
  (paidResult && !paidResult.error && 'aporte registrado; si llega el correo del banco se reconcilia solo') || undefined;
const now = today();
const monthStart = now.slice(0, 8) + '01';
const [balances, spent, shared, deposits, pendingTransfers] = await Promise.all([
  sb.from('account_balances').select('*').order('id'),
  sb.from('transactions')
    .select('amount_cents, account_id, category:categories(name, color)')
    .eq('status', 'confirmed').eq('kind', 'expense').gte('date', monthStart),
  sb.rpc('shared_split'),
  sb.rpc('shared_deposits'),
  sb.from('transactions').select('transfer_id, account_id, user_id, amount_cents').eq('status', 'pending').eq('kind', 'transfer'),
]);
const accounts = balances.data ?? [];
// Cuenta común: su saldo y sus gastos no entran al total ni al gasto del mes de cada persona; van en su aporte.
const splitRows: { account_id: number; user_id: string; email: string; month: string; income_cents: number;
  expense_cents: number; contribution_pct: number; due_day: number; since: string }[] = shared.data ?? [];
const depositRows: { account_id: number; user_id: string; date: string; amount_cents: number }[] = deposits.data ?? [];
const commonIds = new Set(splitRows.map((r) => r.account_id));
const own = accounts.filter((a) => !commonIds.has(a.id));
const currencies = new Set(own.map((a) => a.currency));
const total = own.reduce((s, a) => s + a.balance_cents, 0);
const currency = accounts[0]?.currency ?? 'USD';
const monthName = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('es', { month: 'long' });
const prevStart = splitRows.map((r) => r.month).filter((m) => m < monthStart).sort().at(-1);
// Desde dónde registrar el aporte: tu cuenta por defecto (o la primera tuya que no sea tarjeta).
const payFrom = own.find((a) => a.user_id === me && a.is_default && a.type !== 'credit') ?? own.find((a) => a.user_id === me && a.type !== 'credit');
// Un depósito tuyo que ya espera en la bandeja: el botón lo duplicaría.
const pend = pendingTransfers.data ?? [];
const pendingTo = (accountId: number) => pend.some((t) => t.account_id === accountId && t.amount_cents > 0 &&
  pend.some((o) => o.transfer_id === t.transfer_id && o.amount_cents < 0 && o.user_id === me));
const commons = [...commonIds].map((id) => {
  const rows = splitRows.filter((r) => r.account_id === id);
  const people = [...new Map(rows.map((r) => [r.user_id, r])).values()]; // quien consulta primero (orden de shared_split)
  const { contribution_pct, due_day, since } = rows[0];
  const pct = Number(contribution_pct);
  const prev = rows.filter((r) => r.month === prevStart);
  return {
    id, pct, dueDay: due_day, name: accounts.find((a) => a.id === id)?.name ?? 'cuenta común',
    people: people.map((p) => ({
      ...p,
      c: contribution(pct, due_day, now, since,
        Object.fromEntries(rows.filter((r) => r.user_id === p.user_id).map((r) => [r.month, r.income_cents])),
        depositRows.filter((d) => d.account_id === id && d.user_id === p.user_id)),
    })),
    spent: rows.find((r) => r.month === monthStart)?.expense_cents ?? 0,
    prevMonth: prevStart && monthName(prevStart), prevExpense: prev[0]?.expense_cents ?? 0,
    fair: prev[0]?.expense_cents ? fairPct(prev[0].expense_cents, prev.map((r) => r.income_cents)) : null,
  };
});
// Tu aporte vencido o por vencer va arriba, como el pago de la tarjeta.
const toContribute = commons.flatMap((c) => c.people.filter((p) => p.user_id === me && p.c.left > 0 && (p.c.overdue || p.c.daysLeft <= 7))
  .map((p) => ({ name: c.name, ...p.c })));

// ponytail: gasto del mes sumado en la moneda de la primera cuenta; multi-moneda cuando exista el caso
const byCategory = new Map<string, number>();
for (const t of (spent.data ?? []).filter((t) => !commonIds.has(t.account_id))) {
  const name = (t.category as unknown as { name: string } | null)?.name ?? 'sin categoría';
  byCategory.set(name, (byCategory.get(name) ?? 0) - t.amount_cents);
}
const rows = [...byCategory].sort((a, b) => b[1] - a[1]);
const monthTotal = rows.reduce((s, [, v]) => s + v, 0);
const pct = (cents: number) => Math.max(2, Math.round((cents / monthTotal) * 100));
const month = monthName(monthStart); // con la zona de Ecuador: new Date() en Vercel es UTC y cambiaba de mes a las 19:00
const cards = await cardSummaries(sb, accounts);
const toPay = accounts.flatMap((a) => {
  const c = cards.get(a.id);
  return c && c.status.due > 0 ? [{ a, c }] : [];
});
const ticker = [
  `gasto de ${month} ${formatMoney(monthTotal, currency)}`,
  `${accounts.length} ${accounts.length === 1 ? 'cuenta' : 'cuentas'}`,
  ...[...cards.entries()].map(([id, c]) => `${accounts.find((a) => a.id === id)?.name} corta el ${shortDate(c.cycle.nextClose)}`),
].join('  ✦  ');
---
<Layout title="Saldo" em="total." path="inicio" sculpture="hero" flash={flash}>
  {paidResult?.error && <p class="error">{isInputError(paidResult.error) ? Object.values(paidResult.error.fields).flat()[0] : paidResult.error.message}</p>}
  <section class="flex flex-col gap-2">
    <p class="money-hero text-[clamp(3.5rem,13vw,9rem)]">{currencies.size <= 1 ? formatMoney(total, currency) : 'varias monedas'}</p>
    <p class="meta">total en {own.length} {own.length === 1 ? 'cuenta' : 'cuentas'}{own.some((a) => a.type === 'credit') && ', deudas de tarjeta restadas'}{commons.length > 0 && ', sin la cuenta común'}</p>
  </section>

  <div class="marquee bleed" aria-hidden="true">
    <span>{`${ticker}  ✦  `.repeat(4)}</span>
  </div>

  {toPay.map(({ a, c }) => (
    <a href="/accounts" class:list={['row border-l-2 text-lg sm:pl-4', c.status.overdue ? 'border-l-neg text-neg' : 'border-l-warn text-warn']}>
      <span>{a.name} · {c.status.overdue ? 'vencido: ' : ''}paga {formatMoney(c.status.due, a.currency)} hasta el {shortDate(c.cycle.dueDate)}
      {!c.status.overdue && ` · ${c.status.daysLeft === 0 ? 'hoy' : `faltan ${c.status.daysLeft} días`}`}</span>
    </a>
  ))}
  {toContribute.map((c) => (
    <p class:list={['row border-l-2 text-lg sm:pl-4', c.overdue ? 'border-l-neg text-neg' : 'border-l-warn text-warn']}>
      <span>{c.name} · {c.overdue ? `vencido: aporta ${formatMoney(c.arrears - c.paid, currency)} ya y ${formatMoney(c.left, currency)} en total` : `aporta ${formatMoney(c.left, currency)}`} hasta el {shortDate(c.dueDate)}
      {!c.overdue && ` · ${c.daysLeft === 0 ? 'hoy' : `faltan ${c.daysLeft} días`}`}</span>
    </p>
  ))}

  <section class="flex flex-col">
    <h2 class="prompt head">cuentas</h2>
    {accounts.map((a, i) => (
      <a href="/accounts" class="row">
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <span class="item min-w-0 truncate">{a.name}</span>
        <span class="meta hidden sm:inline">{a.last4 && a.last4.split(',').map((n: string) => `··${n}`).join(' ')}</span>
        <span class:list={['money ml-auto shrink-0 text-xl', a.balance_cents < 0 && 'text-neg']}>{formatMoney(a.balance_cents, a.currency)}</span>
      </a>
    ))}
  </section>

  {commons.map((c) => (
    <section class="win">
      <header class="win-bar"><span class="truncate">aporte · {c.name}</span></header>
      <div class="win-body">
        <p class="meta">cada mes, hasta el día {c.dueDay}, cada persona pone el {c.pct} % de su ingreso del mes anterior · gastado en {month} {formatMoney(c.spent, currency)}</p>
        {c.people.map(({ user_id, email, c: a }) => {
          const you = user_id === me;
          const tone = a.left > 0 && (a.overdue ? 'text-neg' : a.daysLeft <= 7 && 'text-warn');
          return (
            <div class="flex flex-col gap-1">
              <div class="flex items-baseline justify-between gap-3">
                <span class="item min-w-0 truncate">{you ? 'tú' : email}</span>
                <span class:list={['money shrink-0 text-xl', tone]}>{formatMoney(a.due + a.arrears, currency)}</span>
              </div>
              <p class:list={['meta', tone]}>
                {a.left === 0
                  ? `aporte hasta el ${shortDate(a.dueDate)} completo ✓`
                  : a.overdue
                    ? `vencido: ${formatMoney(a.arrears - a.paid, currency)} ya · ${formatMoney(a.left, currency)} en total hasta el ${shortDate(a.dueDate)}`
                    : `${you ? 'te faltan' : 'le faltan'} ${formatMoney(a.left, currency)} hasta el ${shortDate(a.dueDate)} · ${a.daysLeft === 0 ? 'hoy' : `faltan ${a.daysLeft} días`}`}
              </p>
              <p class="meta">
                {a.income > 0 ? `${c.pct} % de ${formatMoney(a.income, currency)} de ${monthName(a.base)}` : `sin ingresos confirmados en ${monthName(a.base)}`}
                {a.arrears > 0 && ` + ${formatMoney(a.arrears, currency)} atrasado`}
                {` · ${you ? 'llevas' : 'lleva'} ${formatMoney(a.paid, currency)}`}
              </p>
              {you && a.left > 0 && (pendingTo(c.id) ? (
                <p class="meta">tu depósito ya está en la <a href="/inbox" class="underline">bandeja</a>: confírmalo ahí</p>
              ) : payFrom && (
                <form method="POST" action={actions.createTransfer} class="mt-2">
                  <input type="hidden" name="from_id" value={payFrom.id} />
                  <input type="hidden" name="to_id" value={c.id} />
                  <input type="hidden" name="amount" value={(a.left / 100).toFixed(2)} />
                  <input type="hidden" name="date" value={now} />
                  <input type="hidden" name="description" value={`Aporte a ${c.name}`} />
                  <Confirm id={`aporte-${c.id}`} yes="sí, registrar" pending="registrando…"
                    question={`¿Registrar el aporte de ${formatMoney(a.left, currency)} desde ${payFrom.name}? Si luego llega el correo del banco, se reconcilia solo.`}>
                    registrar aporte de {formatMoney(a.left, currency)}
                  </Confirm>
                </form>
              ))}
            </div>
          );
        })}
        {c.fair !== null && (
          <p class="meta">con el gasto común de {c.prevMonth} ({formatMoney(c.prevExpense, currency)}) y los ingresos de ese mes, el porcentaje que lo cubre es {c.fair} %</p>
        )}
        <details open={!!setError}>
          <summary>cambiar porcentaje o día</summary>
          <form method="POST" action={actions.setContribution} class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
            <input type="hidden" name="account_id" value={c.id} />
            <label class="label">% del ingreso
              <input class="input" name="contribution_pct" inputmode="decimal" required pattern="\d{1,3}([.,]\d{1,2})?" value={c.fair ?? c.pct} />
            </label>
            <label class="label">Día límite
              <input class="input" name="due_day" type="number" min="1" max="31" required value={c.dueDay} />
            </label>
            <div><button class="btn" data-pending="guardando…">guardar</button></div>
            {setError && <p class="error sm:col-span-3">{setError}</p>}
            <p class="text-sm text-dim sm:col-span-3">Cambia para las dos personas. El aporte de cada mes es el % del ingreso del mes anterior; lo que falte al vencer se suma al siguiente.</p>
          </form>
        </details>
      </div>
    </section>
  ))}

  <section class="box flex flex-col gap-4">
    <div class="flex items-baseline justify-between gap-2">
      <h2 class="prompt">gasto de {month}</h2>
      <span class="money text-xl">{formatMoney(monthTotal, currency)}</span>
    </div>
    {commons.length > 0 && <p class="meta -mt-2">sin la cuenta común (su gasto va en el aporte)</p>}
    {rows.length === 0 && <p class="meta">sin gastos confirmados este mes. buen comienzo.</p>}
    {rows.map(([name, cents]) => (
      <a href={`/transactions?tipo=expense&cat=${encodeURIComponent(name === 'sin categoría' ? '-' : name)}&desde=${monthStart}`}
        class="group grid grid-cols-[1fr_auto] items-baseline gap-x-3 gap-y-1.5 sm:grid-cols-[9rem_1fr_6rem] sm:gap-y-0">
        <span class="truncate text-sm tracking-[0.2em] text-dim uppercase group-hover:text-fg sm:col-start-1 sm:row-start-1">{name}</span>
        <span class="bar col-span-2 row-start-2 sm:col-span-1 sm:col-start-2 sm:row-start-1"><span class="dither block h-1" style={`width:${pct(cents)}%`}></span></span>
        <span class="money text-right text-base sm:col-start-3 sm:row-start-1">{formatMoney(cents, currency)}</span>
      </a>
    ))}
  </section>
</Layout>
